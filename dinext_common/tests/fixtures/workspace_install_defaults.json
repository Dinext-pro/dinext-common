{
  "settings_name": "Dinext",
  "show_frequent_pages": 1,
  "show_recent_pages": 1,
  "doctype_items": [
    {
      "section": "My Work",
      "document_type": "Issue",
      "enabled": 1,
      "show_quick_create": 1,
      "show_assigned": 1,
      "show_liked": 1,
      "show_attention": 1,
      "attention_filter": "[\n [\n  \"Issue\",\n  \"status\",\n  \"in\",\n  [\n   \"Open\",\n   \"Replied\",\n   \"On Hold\"\n  ],\n  false\n ],\n [\n  \"Issue\",\n  \"custom_is_overdue\",\n  \"=\",\n  1,\n  false\n ]\n]",
      "list_filter": "[\n [\n  \"Issue\",\n  \"status\",\n  \"in\",\n  [\n   \"Open\",\n   \"Replied\",\n   \"On Hold\"\n  ],\n  false\n ]\n]",
      "source_app": "dinext_projects"
    },
    {
      "section": "My Work",
      "document_type": "Task",
      "enabled": 1,
      "show_quick_create": 1,
      "show_assigned": 1,
      "show_liked": 1,
      "show_attention": 1,
      "attention_filter": "[\n [\n  \"Task\",\n  \"status\",\n  \"=\",\n  \"Overdue\",\n  false\n ],\n [\n  \"Task\",\n  \"type\",\n  \"!=\",\n  \"Issue\",\n  false\n ]\n]",
