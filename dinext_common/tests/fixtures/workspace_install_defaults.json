      "show_assigned": 1,
      "show_liked": 0,
      "show_attention": 1,
      "attention_filter": "[\n [\n  \"Project\",\n  \"workflow_state\",\n  \"=\",\n  \"\\u041d\\u0430 \\u0441\\u043e\\u0433\\u043b\\u0430\\u0441\\u043e\\u0432\\u0430\\u043d\\u0438\\u0438\",\n  false\n ]\n]",
      "list_filter": "[\n [\n  \"Project\",\n  \"status\",\n  \"not in\",\n  [\n   \"Completed\",\n   \"Cancelled\"\n  ],\n  false\n ]\n]",
      "source_app": "dinext_projects"
